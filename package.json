{
  "name": "@ferris1225/pi-subagents",
  "version": "4.2.12",
  "description": "A managed sub-agent team for pi: specialized roles, pre-commit documentation sync, retained threads, auto-fix chains, model fallback, and Git worktree isolation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCapricorns/pi-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/MCapricorns/pi-subagents/issues"
  },
  "homepage": "https://github.com/MCapricorns/pi-subagents#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "sub-agent",
    "delegation",
    "code-cleanup",
    "dead-code"
  ],
  "files": [
    "src",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.84.4",
    "@earendil-works/pi-ai": ">=0.84.4",
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@earendil-works/pi-tui": ">=0.84.4",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.10.0",
    "typebox": "^1.3.9",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
