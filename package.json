{
  "name": "@ferris1225/pi-subagents",
  "version": "7.0.6",
  "description": "Lead/worker orchestration for Pi: main plans and reviews, configurable workers execute with retained sessions and Git worktree isolation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCapricorns/pi-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/MCapricorns/pi-subagents/issues"
  },
  "homepage": "https://github.com/MCapricorns/pi-subagents#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "sub-agent",
    "delegation",
    "orchestration"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "npm run check:unused && npm test",
    "check:unused": "tsc --noEmit && knip",
    "check:staged": "node scripts/check-staged.mjs",
    "test": "node --test --test-concurrency=4 test/*.test.ts",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.2",
    "@earendil-works/pi-coding-agent": ">=1.5.2",
    "@earendil-works/pi-tui": ">=1.5.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.10.0",
    "knip": "6.48.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
